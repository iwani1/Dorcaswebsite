# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- Vendor archives ---
# The original ThemeForest "all files" package is NOT tracked here.
# Keep it as a GitHub release asset / external backup instead.
*.zip
# exception: the plugin bundle the theme's TGMPA installer ships
!wp-content/themes/luxrio/inc/luxrio-framework/plugins/luxrio-core.zip

# --- WordPress runtime and secrets (never commit) ---
wp-config.php
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/languages/
*.log

# --- Build artefacts ---
*.map

# --- Generated client pack (rebuild with tools/build-client-pack.sh) ---
client/pack/

# python bytecode from the brand generators
__pycache__/
*.pyc
